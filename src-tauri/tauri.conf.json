{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PeachTerm",
  "version": "0.5.0",
  "identifier": "dev.peachterm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PeachTerm",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 420,
        "center": true,
        "backgroundColor": "#141413",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "dmg", "app"],
    "category": "DeveloperTool",
    "shortDescription": "Lightweight SSH client with integrated SFTP",
    "publisher": "Bakhti Baymukhamedov",
    "copyright": "Copyright 2026 Bakhti Baymukhamedov",
    "homepage": "https://github.com/endlessnights/peachterm",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null
    }
  }
}
