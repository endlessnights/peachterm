    { "accel": "Mod+Shift+C", "reason": "opens developer tools" },
    { "accel": "Mod+0", "reason": "changes the web view zoom" },
    { "accel": "Mod+=", "reason": "changes the web view zoom" },
    { "accel": "Mod+-", "reason": "changes the web view zoom" },
