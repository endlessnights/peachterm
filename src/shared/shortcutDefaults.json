    { "id": "duplicateTab", "default": "Mod+Shift+D" },
    { "id": "splitVertical", "default": "Mod+Shift+E" },
    { "id": "splitHorizontal", "default": "Mod+Shift+O" },
    { "id": "toggleSplitOrientation", "default": "Mod+Shift+U" },
    { "id": "focusNextPane", "default": "Mod+Shift+P" },
    { "id": "unsplit", "default": "Mod+Shift+X" }
